{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kukla",
  "version": "0.2.0",
  "identifier": "com.kukla.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
"windows": [
      {
        "title": "Kukla",
        "width": 1000,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false,
        "userAgent": "Kukla",
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://bedesten.adalet.gov.tr https://karararama.yargitay.gov.tr https://github.com https://*.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNUI2QUFGRjVFMkEwOTAKUldTUW9PTDFyMnBiLzlUdk16ZU01QnpRY05tRXNDc3hkV21xUVhYY2ZYVEpOTmp1VHd1U1dKbFoK",
      "endpoints": [
        "https://github.com/ekuragli/Kukla/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
